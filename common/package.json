{
  "name": "@sproot/common",
  "private": true,
  "description": "Sproot common libraries",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build --verbose",
    "clean": "rimraf tsconfig.tsbuildinfo && rimraf ./dist",
    "lint": "npx eslint ./src",
    "coverage": "nyc npm run test",
    "prettier:write": "npm exec -- prettier . --write",
    "prettier:check": "npm exec -- prettier . --check",
    "test": "mocha -r ts-node/register --colors ./src/**/*.spec.ts",
    "check": "npm run prettier:check && mocha -r ts-node/register --colors ./src/**/*.spec.ts"
  },
  "author": "Ben Steele",
  "license": "ISC",
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.8.1",
    "mocha": "^11.8.0",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "sinon": "^22.1.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "winston": "^3.19.0"
  },
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
