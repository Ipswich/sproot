services:
  camera:
    profiles:
      - camera
    build:
      context: ./
      dockerfile: ./camera/Dockerfile
    restart: unless-stopped
    environment:
      TZ: America/Los_Angeles
      INTERSERVICE_AUTHENTICATION_KEY: CHANGE ME #Change this to something long and unique
      CAMERA_PORT: 3002
      CAMERA_VIDEO_RESOLUTION: 1280x960
      CAMERA_FPS: 30
      CAMERA_GRACEFUL_SHUTDOWN_TIMEOUT: 10
    volumes:
      - /run/udev:/run/udev:ro
      - /sys:/sys
    network_mode: "host"
    privileged: true
    expose:
      - "3002"

  server:
    depends_on:
      postgres:
        condition: service_healthy
    build:
       context: ./
       dockerfile: ./server/Dockerfile.development
    environment:
      TZ: America/Los_Angeles
      NODE_ENV: development
      DEFAULT_USER: dev-test
      DEFAULT_USER_EMAIL: dev-test@example.com
      DEFAULT_USER_PASSWORD: password
      AUTHENTICATION_ENABLED: false
      JWT_SECRET: CHANGE ME #Change this to something long and unique
      JWT_EXPIRATION: 259200000 #3 days in MS
      DATABASE_HOST: 127.0.0.1
      DATABASE_PORT: 5432
      DATABASE_USER: postgres
      DATABASE_PASSWORD: root
      INTERSERVICE_AUTHENTICATION_KEY: CHANGE ME #Change this to something long and unique
    volumes:
      - /sys:/sys
      - ./docker_volumes/sproot/server/logs:/sproot/server/logs
      - ./docker_volumes/sproot/server/images:/sproot/server/images
      - ./docker_volumes/sproot/server/certs:/sproot/server/certs
      - ./docker_volumes/sproot/server/backups:/sproot/server/backups
    network_mode: "host"
    privileged: true
    expose:
      - "3000"
    command: ["sleep", "infinity"]
  
  client:
    depends_on:
      - server
    build:
      context: ./
      dockerfile: ./gateway/Dockerfile.development
      args:
        VITE_VERSION: 0.0.0
        VITE_API_SERVER_URL: ""
    environment:
      NODE_ENV: development
      TLS_AUTO_IP: "true"
      TLS_SANS: ""
      TLS_CERT_DAYS: "825"
      TLS_RENEW_BEFORE_DAYS: "30"
      TLS_KEY_TYPE: "ec"
      TLS_EC_CURVE: "prime256v1"
    volumes:
      - ./docker_volumes/sproot/client/logs:/sproot/logs
      - ./docker_volumes/sproot/gateway/certs:/etc/nginx/certs
    network_mode: "host"
    expose:
      - "80"
      - "443"

  postgres:
    build:
      context: ./
      dockerfile: ./postgres/Dockerfile
    pull_policy: never
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: root
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 3s
      retries: 20
    volumes:
      - ./docker_volumes/postgresql:/var/lib/postgresql
    network_mode: "host"
    expose:
      - "5432"

  pgadmin:
    image: dpage/pgadmin4:9.14.0
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    entrypoint:
      - /bin/sh
      - -ec
      - |
          if [ -n "$${PGADMIN_SERVER_JSON:-}" ] && { [ ! -f "$${PGADMIN_SERVER_JSON_FILE:-/tmp/servers.json}" ] || [ "$${PGADMIN_REPLACE_SERVERS_ON_STARTUP:-}" = "True" ]; }; then
            printf '%s\n' "$$PGADMIN_SERVER_JSON" > "$${PGADMIN_SERVER_JSON_FILE:-/tmp/servers.json}"
          fi
          exec /entrypoint.sh "$@"
    network_mode: "host"
    environment:
      PGADMIN_LISTEN_PORT: 3001
      PGADMIN_DEFAULT_EMAIL: admin@local.host
      PGADMIN_DEFAULT_PASSWORD: root
      PGADMIN_SERVER_JSON_FILE: /tmp/servers.json
      PGADMIN_REPLACE_SERVERS_ON_STARTUP: 'True'
      PGADMIN_CONFIG_SERVER_MODE: 'False'
      PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED: 'False'
      PGADMIN_DISABLE_POSTFIX: 'True'
      PGADMIN_CONFIG_ENHANCED_COOKIE_PROTECTION: 'False'
      PGADMIN_CONFIG_CONSOLE_LOG_LEVEL: 30
      PGADMIN_CONFIG_UPGRADE_CHECK_ENABLED: 'False'
      PGADMIN_CONFIG_CHECK_SUPPORTED_BROWSER: 'False'
      PGADMIN_CONFIG_ALLOW_SAVE_PASSWORD: 'True'
      PGADMIN_SERVER_JSON: |
        {
          "Servers": {
            "1": {
              "Name": "Sproot",
              "Group": "Servers",
              "Host": "127.0.0.1",
              "Port": 5432,
              "MaintenanceDB": "postgres",
              "Username": "postgres",
              "SSLMode": "prefer"
            }
          }
        }
    volumes:
      - pgadmin_runtime:/var/lib/pgadmin

volumes:
  pgadmin_runtime:
