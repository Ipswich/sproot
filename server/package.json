{
  "name": "@sproot/server",
  "private": true,
  "description": "sproot-server, the backend for the sproot project",
  "main": "index.js",
  "scripts": {
    "build": "tsc --build --verbose",
    "clean": "rimraf tsconfig.tsbuildinfo && rimraf ./dist",
    "coverage": "nyc npm run test",
    "lint": "npx eslint ./src",
    "prettier:write": "npm exec -- prettier . --write",
    "prettier:check": "npm exec -- prettier . --check",
    "start": "npm run build && node ./dist/index.js",
    "start:dev": "npx nodemon --delay 3",
    "test": "npm run build && mocha -r ts-node/register --colors --exclude 'src/test/**/*.spec.ts' 'src/**/*.spec.ts'",
    "test:api": "npm run build && DOTENV_CONFIG_PATH=.env.test npx mocha -r ts-node/register -r mocha --file ./src/test/setup.ts --colors './src/test/**/*.spec.ts'",
    "check": "npm run prettier:check && mocha -r ts-node/register --colors ./src/**/*.spec.ts"
  },
  "author": "Ben Steele",
  "license": "ISC",
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/bcrypt": "^6.0.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "@types/node-forge": "^1.3.14",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.8.1",
    "mocha": "^11.8.0",
    "nock": "^14.0.17",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "sinon": "^22.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "tplink-smarthome-simulator": "^5.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@sproot/common": "file:../common",
    "bcrypt": "^6.0.0",
    "bme280": "github:jhoffi/bme280-typings",
    "bonjour-service": "^1.4.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "esptool-js": "^0.6.1",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.11.0",
    "node-forge": "^1.4.0",
    "pca9685": "^5.0.0",
    "pg": "^8.22.0",
    "serialport": "^13.0.0",
    "suncalc": "^2.0.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tplink-smarthome-api": "^5.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yamljs": "^0.3.0"
  }
}
