{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@sproot/common/*": ["../common/dist/*"],
      "@sproot/*": ["../common/dist/*"]
    }
  },
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "references": [
    {
      "path": "../common"
    }
  ],
  "include": ["src/**/*.ts"]
}
