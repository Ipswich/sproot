{
  "name": "@sproot/sproot-client",
  "private": true,
  "type": "module",
  "description": "sproot-client, the frontend for the sproot project",
  "scripts": {
    "clean": "rimraf tsconfig.node.tsbuildinfo && rimraf ./dist",
    "build": "tsc --build --verbose && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prettier:write": "npm exec -- prettier . --write",
    "prettier:check": "npm exec -- prettier . --check",
    "preview": "vite preview",
    "start:dev": "vite --host"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@dnd-kit/accessibility": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@mantine/charts": "^9.5.1",
    "@mantine/core": "^9.5.1",
    "@mantine/dates": "^9.5.1",
    "@mantine/form": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "dayjs": "^1.11.21",
    "esptool-js": "^0.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "suncalc": "^2.0.1"
  }
}
